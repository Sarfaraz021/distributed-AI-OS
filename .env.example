# LLM providers (LiteLLM reads these automatically)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional tracing
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=mini-aios

# Supabase / Postgres (direct URI, port 5432)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Gateway
LLM_BACKEND=fake
LLM_MODEL=openai/gpt-4o-mini
FAULT_INJECT_429=false
CRASH_AFTER_EMAIL=false
