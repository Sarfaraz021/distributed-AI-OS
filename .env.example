# LLM providers (LiteLLM reads these automatically)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional tracing
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=mini-aios

# Supabase / Postgres
# DIRECT_URL = session pooler (port 5432). mini-aios uses this.
# DATABASE_URL = transaction pooler (port 6543). Prisma-style; unused by this app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Gateway
LLM_BACKEND=fake
LLM_MODEL=openai/gpt-4o-mini
FAULT_INJECT_429=false
CRASH_AFTER_EMAIL=false
